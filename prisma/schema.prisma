model TradeInBatteryRange {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  label     String
  minPct    Int
  maxPct    Int
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  prices TradeInPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, minPct, maxPct])
  @@index([tenantId, isActive])
}

model TradeInPrice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  modelName      String
  capacityGB     Int
  batteryRangeId String
  batteryRange   TradeInBatteryRange @relation(fields: [batteryRangeId], references: [id])

  referencePrice Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, modelName, capacityGB, batteryRangeId])
  @@index([tenantId, modelName, capacityGB])
}

model TradeInDeductionRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  category   TradeInDeductionCategory
  label      String
  amount     Decimal                  @default(0) @db.Decimal(12, 2)
  scope      TradeInDeductionScope    @default(GLOBAL)
  modelName  String?
  capacityGB Int?
  isActive   Boolean                  @default(true)
  sortOrder  Int                      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, category, isActive])
  @@index([tenantId, scope, modelName, capacityGB])
}

enum TradeInDeductionScope {
  GLOBAL
  MODEL
  MODEL_CAPACITY
}

enum TradeInDeductionCategory {
  PANTALLA_MODULO
  TAPA
  CAMARA
  FUNCIONAMIENTO
  OTRO
}

enum BuyerType {
  MINORISTA
  MAYORISTA
}
