// prisma/schema.prisma
// Venta con Buyer y Payments; accesorios pueden ser:
// - NORMAL (cobra precio)
// - IN_TOTAL (costo x producto: baja stock y suma a Sale.extraCosts)
// Además, SaleItem puede vincularse a un teléfono via parentItemId.
// Se mantiene CostProfile para extras por teléfono; SaleItem guarda selección/desglose en JSON.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  isActive        Boolean   @default(true)
  role            UserRole
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  currentBranchId String?
  currentBranch   Branch?   @relation("UserCurrentBranch", fields: [currentBranchId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  lastLoginAt     DateTime?
  invitedAt       DateTime?
  joinedAt        DateTime?
  invitedById     String?
  invitedBy       User?     @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers    User[]    @relation("UserInvitations")

  appointments           Appointment[]
  sales                  Sale[]               @relation("SaleCreatedBy")
  closedSales            Sale[]               @relation("SaleCloser")
  reservations           Reservation[]
  serviceOrders          ServiceOrder[]       @relation("ServiceOrderTechnician")
  createdServiceOrders   ServiceOrder[]       @relation("ServiceOrderCreatedBy")
  auditLogs              AuditLog[]           @relation("AuditLogActor")
  generatedSaleReceipts  SaleReceipt[]        @relation("SaleReceiptGeneratedBy")
  customerOrdersCreated  CustomerOrder[]      @relation("CustomerOrderCreatedBy")
  customerOrdersAssigned CustomerOrder[]      @relation("CustomerOrderAssignedSeller")
  cashMovements          CashMovement[]
  cashTransfers          CashTransfer[]
  closedCashDays         CashDailyClose[]     @relation("CashDailyCloseClosedBy")
  closerCommissions      CloserCommission[]   @relation("CloserCommissionCloser")
  branchCoverages        UserBranchCoverage[]

  @@index([currentBranchId])
  @@index([invitedById])
}

/// Pensado para SaaS a futuro. En R1 podés crear 1 Tenant por defecto y listo.
// El Tenant administra sus productos, ventas, órdenes, compras y proveedores. Como un encargado por sucursal.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products              Product[]
  sales                 Sale[]
  orders                WholesaleOrder[]
  customerOrders        CustomerOrder[]
  costProfiles          CostProfile[]
  purchases             Purchase[]
  suppliers             Supplier[]
  buyers                Buyer[]
  users                 User[]
  branches              Branch[]
  reservations          Reservation[]
  serviceOrders         ServiceOrder[]
  auditLogs             AuditLog[]
  cashAccounts          CashAccount[]
  cashMovements         CashMovement[]
  cashTransfers         CashTransfer[]
  cashDailyCloses       CashDailyClose[]
  closerCommissionPlans CloserCommissionPlan[]
  closerCommissions     CloserCommission[]
  settings              TenantSettings?
  assets                TenantAsset[]
  catalogModels         ProductCatalogModel[]
  catalogCapacities     ProductCatalogCapacity[]
  catalogMeasures       ProductCatalogMeasure[]
  catalogColors         ProductCatalogColor[]
  catalogColorAliases   ProductCatalogColorAlias[]
  modelCompatibilities  ProductModelCompatibility[]

  tradeInBatteryRanges  TradeInBatteryRange[]
  tradeInPrices         TradeInPrice[]
  tradeInDeductionRules TradeInDeductionRule[]
}

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  servicePickupAlertDays Int @default(15)

  stockRotationHighMaxDays   Int @default(15)
  stockRotationMediumMaxDays Int @default(30)

  accessoryLowStockThreshold Int @default(5)

  wholesalePricesEnabled Boolean @default(false)

  closerCommissionsEnabled Boolean @default(false)

  financialFeeEnabled Boolean @default(true)
  financialFeeRatePct Decimal @default(3.5) @db.Decimal(5, 2)

  bnaInstallmentsEnabled  Boolean @default(false)
  bnaMarkupRatePct        Decimal @default(40) @db.Decimal(5, 2)
  bnaDefaultInstallments  Int     @default(12)
  bnaCustomerRebatePct    Decimal @default(10) @db.Decimal(5, 2)
  bnaCustomerRebateCapArs Decimal @default(30000) @db.Decimal(12, 2)

  customerOrderMinimumDepositUsd   Decimal @default(100) @db.Decimal(12, 2)
  customerOrderDefaultDeliveryDays Int     @default(7)
  customerOrderDeliveryDisclaimer  String  @default("Fecha de entrega estimada. Puede presentar demoras por logística, disponibilidad de proveedor o causas ajenas al negocio.") @db.Text

  usedDeviceWarrantyDays Int    @default(30)
  warrantyPolicyText     String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantAsset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind      TenantAssetKind
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind])
  @@index([tenantId])
}

model ProductCatalogModel {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type           ProductType
  name           String
  normalizedName String
  source         CatalogSource @default(CUSTOM)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  products                 Product[]
  phoneCompatibilities     ProductModelCompatibility[] @relation("CompatiblePhoneModel")
  accessoryCompatibilities ProductModelCompatibility[] @relation("CompatibleAccessoryModel")
  customerOrderItems       CustomerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, normalizedName])
  @@index([tenantId, type, isActive])
}

model ProductCatalogCapacity {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  capacityGB Int
  label      String
  source     CatalogSource @default(CUSTOM)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)

  products           Product[]
  customerOrderItems CustomerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, capacityGB])
  @@index([tenantId, isActive])
}

model ProductCatalogMeasure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label       String
  millimeters Decimal       @db.Decimal(8, 2)
  source      CatalogSource @default(CUSTOM)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, millimeters])
  @@index([tenantId, isActive])
}

model ProductCatalogColor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  normalizedName String
  hexColor       String
  source         CatalogSource @default(CUSTOM)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  aliases            ProductCatalogColorAlias[]
  products           Product[]
  customerOrderItems CustomerOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive])
}

model ProductCatalogColorAlias {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  colorId String
  color   ProductCatalogColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  alias           String
  normalizedAlias String

  createdAt DateTime @default(now())

  @@unique([tenantId, normalizedAlias])
  @@index([colorId])
}

model ProductModelCompatibility {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phoneModelId String
  phoneModel   ProductCatalogModel @relation("CompatiblePhoneModel", fields: [phoneModelId], references: [id], onDelete: Cascade)

  accessoryModelId String
  accessoryModel   ProductCatalogModel @relation("CompatibleAccessoryModel", fields: [accessoryModelId], references: [id], onDelete: Cascade)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phoneModelId, accessoryModelId])
  @@index([tenantId, phoneModelId, isActive])
  @@index([tenantId, accessoryModelId, isActive])
}

model Province {
  id   String @id
  name String
  code String @unique

  buyers          Buyer[]
  suppliers       Supplier[]
  branches        Branch[]                 @relation("BranchProvince")
  branchCoverages BranchProvinceCoverage[]

  @@index([name])
}

/// Catálogo unificado: iPhones y accesorios.
// Para MVP trabajamos con stock agregado (no por IMEI). IMEI se puede agregar en el futuro.
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type              ProductType // PHONE | ACCESSORY
  brand             String? // p.ej. "Apple" (opcional en accesorios)
  imei              String? // opcional, sólo si se maneja por IMEI
  modelName         String // p.ej. "iPhone 15 Pro", "Funda 14 Pro Max"
  capacityGB        Int? // sólo aplica a PHONE
  condition         Condition? // A_PLUS | OEM | ASIS | ASIS_PLUS | SEALED (para PHONE)
  color             String?
  batteryPct        Int? // sólo PHONE; si aplica
  purchaseDate      DateTime? // fecha_de_compra
  costPrice         Decimal                 @db.Decimal(12, 2) // costo_x_unidad
  salePrice         Decimal                 @db.Decimal(12, 2) // precio_venta_x_unidad (precio sugerido/base)
  shippingCost      Decimal?                @db.Decimal(12, 2) // costo_envio (si es fijo/por unidad)
  wholesalePrice    Decimal?                @db.Decimal(12, 2)
  status            ProductStatus           @default(AVAILABLE)
  state             ProductState            @default(EN_CAMINO) // estado actual del producto
  senado            Boolean                 @default(false)
  senadoAt          DateTime?
  stockInitial      Int                     @default(1) // stock inicial
  stock             Int                     @default(1) // stock actual
  stockAvailable    Int                     @default(1) // stock disponible para venta
  location          String? // opcional, para saber dónde está el producto, después se puede usar para filtrar por ubicación y agregar un modelo Sede con datos de ubiacion, contacto, direccion, etc.
  branchId          String?
  branch            Branch?                 @relation(fields: [branchId], references: [id])
  supplierId        String?
  supplier          Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  origin            String? // "Proveedor Alex", "Compra en ML", "Trade-in Apple", "Plan Canje", etc.
  notes             String?
  catalogModelId    String?
  catalogModel      ProductCatalogModel?    @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)
  catalogCapacityId String?
  catalogCapacity   ProductCatalogCapacity? @relation(fields: [catalogCapacityId], references: [id], onDelete: SetNull)
  catalogColorId    String?
  catalogColor      ProductCatalogColor?    @relation(fields: [catalogColorId], references: [id], onDelete: SetNull)

  saleItems    SaleItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  PurchaseItem PurchaseItem[]

  // NUEVO: productos marcados como “de interés” en citas
  appointmentInterests        AppointmentInterest[]
  reservationItems            ReservationItem[]
  serviceOrders               ServiceOrder[]
  customerOrderStockItems     CustomerOrderItem[]                @relation("CustomerOrderItemStockProduct")
  customerOrderFulfilledItems CustomerOrderItem[]                @relation("CustomerOrderItemFulfilledProduct")
  customerOrderAllocations    CustomerOrderInventoryAllocation[]

  @@index([tenantId, type, modelName])
  @@index([tenantId, modelName, capacityGB, condition])
  @@index([branchId])
  @@index([supplierId])
  @@index([catalogModelId])
  @@index([catalogCapacityId])
  @@index([catalogColorId])
}

model Buyer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type BuyerType @default(MINORISTA)

  name         String
  surname      String?
  businessName String?
  dni          String?
  cuit         String?
  dob          DateTime?
  /// LEGACY: texto libre historico. Usar provinceId/provinceRef para datos normalizados.
  province     String?
  provinceId   String?
  provinceRef  Province? @relation(fields: [provinceId], references: [id])
  city         String?
  postalCode   String?

  registeredBranchId String?
  registeredBranch   Branch? @relation("BuyerRegisteredBranch", fields: [registeredBranchId], references: [id])

  notes String?

  email         String?
  instagram     String?
  phone         String?
  addressStreet String?
  addressNumber String?

  sales Sale[]

  appointments   Appointment[]
  reservations   Reservation[]
  serviceOrders  ServiceOrder[]
  customerOrders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([tenantId, surname])
  @@index([tenantId, businessName])
  @@index([tenantId, dni])
  @@index([tenantId, cuit])
  @@index([tenantId, instagram])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, province, city])
  @@index([provinceId])
  @@index([registeredBranchId])
}

/// Venta encabezado.
model Sale {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String?
  user   User?   @relation("SaleCreatedBy", fields: [userId], references: [id])

  closerId String?
  closer   User?   @relation("SaleCloser", fields: [closerId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  saleType SaleType?

  date         DateTime @default(now())
  customerName String? // libre si no hay Buyer (legacy)
  origin       String? // "Local", "Conocido", "Instagram", etc.
  notes        String?

  exchangeRate       Decimal?  @db.Decimal(12, 4)
  exchangeRateSource String?
  exchangeRateAt     DateTime?

  // Relación con Buyer (opcional)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  items             SaleItem[]
  payments          Payment[]
  receipt           SaleReceipt?
  customerOrder     CustomerOrder?
  closerCommissions CloserCommission[]

  // NUEVO: citas que terminaron en esta venta (en la práctica suele ser 0 o 1)
  appointments Appointment[]

  status     SaleStatus @default(CONFIRMADA)
  amountPaid Decimal    @default(0) @db.Decimal(12, 2)
  balanceDue Decimal    @default(0) @db.Decimal(12, 2)

  // Totales (recomendado recalcular en servidor)
  subtotal     Decimal       @db.Decimal(12, 2) // Σ (NORMAL line: units*unitPrice)
  costTotal    Decimal       @default(0) @db.Decimal(12, 2) // Σ (items.unitCost)
  extraCosts   Decimal       @db.Decimal(12, 2) // Σ (IN_TOTAL items + extraCost de CostProfile en PHONE)
  total        Decimal       @db.Decimal(12, 2) // subtotal + extraCosts
  profit       Decimal       @db.Decimal(12, 2) // total - costo_total
  createdAt    DateTime      @default(now())
  reservations Reservation[]

  @@index([tenantId, date])
  @@index([buyerId])
  @@index([status])
  @@index([closerId])
  @@index([branchId])
  @@index([saleType])
}

model SaleReceipt {
  id Int @id @default(autoincrement())

  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  generatedAt DateTime @default(now())

  generatedById String?
  generatedBy   User?   @relation("SaleReceiptGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([generatedAt])
  @@index([generatedById])
}

/// Renglón de una venta.
// Puede vincularse a otro renglón (p. ej., accesorio vinculado al teléfono) vía parentItemId.
model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Vinculación jerárquica: accesorios colgados de un PHONE
  parentItemId String?
  parentItem   SaleItem?  @relation("SaleItemChildren", fields: [parentItemId], references: [id], onDelete: SetNull)
  children     SaleItem[] @relation("SaleItemChildren")

  // Modo del renglón (ver lógica de totales)
  kind SaleItemKind @default(NORMAL)

  units     Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2) // precio_venta por unidad (0 si ZERO_COST)
  unitCost  Decimal @db.Decimal(12, 2) // costo base del producto (sin extras)

  // CostProfile aplicado (sólo si corresponde, típicamente en PHONE)
  costProfileAppliedId String?
  costProfileApplied   CostProfile? @relation(fields: [costProfileAppliedId], references: [id])

  // Extras seleccionados del CostProfile para este ítem (PHONE)
  // Ej.: ["FUNDA","ENVIO"]; desglose: { FUNDA: "100.00", ENVIO: "500.00" }
  selectedExtras     Json?
  extraCostBreakdown Json?

  // Cache para cálculos por ítem:
  // - extraCost: por unidad desde CostProfile (solo PHONE)
  // - lineTotal: si kind=NORMAL -> units*unitPrice; si ZERO_COST -> 0; si IN_TOTAL -> 0 (se suma en Sale.extraCosts)
  // - lineCost: units * unitCost + (units * extraCost)  (el accesorio IN_TOTAL no entra aquí como precio)
  // - lineProfit: lineTotal - lineCost
  extraCost  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  lineCost   Decimal @db.Decimal(12, 2)
  lineProfit Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([parentItemId])
  @@index([kind])
}

/// Pago asociado a una venta (sustituye Sale.payment simple).
model Payment {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method                       PaymentMethod
  currency                     Currency              @default(USD) // es mas complejo porque puede estar en diferentes currencies, pero lo ideal seria llevar los payments con currency != USD a su valor equivalente en USD
  amount                       Decimal               @db.Decimal(12, 2)
  exchangeRate                 Decimal?              @db.Decimal(12, 4)
  amountUsd                    Decimal?              @db.Decimal(12, 2)
  coveredBaseUsd               Decimal?              @db.Decimal(14, 6)
  surchargePct                 Decimal?              @db.Decimal(5, 2)
  surchargeAmount              Decimal?              @db.Decimal(12, 2)
  installments                 Int?
  installmentAmount            Decimal?              @db.Decimal(12, 2)
  pricingSnapshot              Json?
  cashAccountId                String?
  cashAccount                  CashAccount?          @relation("SalePaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  originReservationPaymentId   String?               @unique
  originReservationPayment     ReservationPayment?   @relation("ReservationPaymentConvertedToSalePayment", fields: [originReservationPaymentId], references: [id], onDelete: SetNull)
  originCustomerOrderPaymentId String?               @unique
  originCustomerOrderPayment   CustomerOrderPayment? @relation("CustomerOrderPaymentConvertedToSalePayment", fields: [originCustomerOrderPaymentId], references: [id], onDelete: SetNull)
  paidAt                       DateTime              @default(now())
  note                         String?

  createdAt DateTime @default(now())

  @@index([saleId, paidAt])
  @@index([cashAccountId])
  @@index([coveredBaseUsd])
}

model CustomerOrder {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  createdById String?
  createdBy   User?   @relation("CustomerOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignedSellerId String?
  assignedSeller   User?   @relation("CustomerOrderAssignedSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  convertedSaleId String? @unique
  convertedSale   Sale?   @relation(fields: [convertedSaleId], references: [id], onDelete: SetNull)

  status CustomerOrderStatus @default(CONFIRMED)
  source CustomerOrderSource @default(INTERNAL)

  requestedAt         DateTime  @default(now())
  estimatedDeliveryAt DateTime?

  agreedTotalUsd Decimal @db.Decimal(12, 2)
  amountPaidUsd  Decimal @default(0) @db.Decimal(12, 2)
  balanceDueUsd  Decimal @default(0) @db.Decimal(12, 2)

  notes                      String?
  customerNameSnapshot       String?
  customerDocumentSnapshot   String?
  customerPhoneSnapshot      String?
  customerEmailSnapshot      String?
  deliveryDisclaimerSnapshot String?

  cancelledAt DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  items       CustomerOrderItem[]
  payments    CustomerOrderPayment[]
  allocations CustomerOrderInventoryAllocation[]

  @@index([tenantId, requestedAt])
  @@index([tenantId, status])
  @@index([buyerId])
  @@index([createdById])
  @@index([assignedSellerId])
  @@index([branchId])
  @@index([appointmentId])
}

model CustomerOrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind CustomerOrderItemKind

  stockProductId String?
  stockProduct   Product? @relation("CustomerOrderItemStockProduct", fields: [stockProductId], references: [id], onDelete: SetNull)

  fulfilledProductId String?
  fulfilledProduct   Product? @relation("CustomerOrderItemFulfilledProduct", fields: [fulfilledProductId], references: [id], onDelete: SetNull)

  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  catalogModelId String?
  catalogModel   ProductCatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)

  catalogCapacityId String?
  catalogCapacity   ProductCatalogCapacity? @relation(fields: [catalogCapacityId], references: [id], onDelete: SetNull)

  catalogColorId String?
  catalogColor   ProductCatalogColor? @relation(fields: [catalogColorId], references: [id], onDelete: SetNull)

  descriptionSnapshot String
  modelNameSnapshot   String?
  capacityGBSnapshot  Int?
  colorSnapshot       String?
  conditionSnapshot   Condition?

  quantity     Int      @default(1)
  unitPriceUsd Decimal  @db.Decimal(12, 2)
  unitCostUsd  Decimal? @db.Decimal(12, 2)
  lineTotalUsd Decimal  @db.Decimal(12, 2)
  notes        String?

  allocation CustomerOrderInventoryAllocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([stockProductId])
  @@index([fulfilledProductId])
  @@index([purchaseItemId])
  @@index([catalogModelId])
}

model CustomerOrderInventoryAllocation {
  id      String        @id @default(cuid())
  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId String            @unique
  item   CustomerOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  status   CustomerOrderAllocationStatus @default(ACTIVE)

  reservedAt DateTime  @default(now())
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orderId, status])
  @@index([productId, status])
}

model CustomerOrderPayment {
  id      String        @id @default(cuid())
  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  currency Currency      @default(USD)
  amount   Decimal       @db.Decimal(12, 2)

  exchangeRate      Decimal? @db.Decimal(12, 4)
  amountUsd         Decimal? @db.Decimal(12, 2)
  coveredBaseUsd    Decimal? @db.Decimal(14, 6)
  surchargePct      Decimal? @db.Decimal(5, 2)
  surchargeAmount   Decimal? @db.Decimal(12, 2)
  installments      Int?
  installmentAmount Decimal? @db.Decimal(12, 2)
  pricingSnapshot   Json?

  cashAccountId String?
  cashAccount   CashAccount? @relation("CustomerOrderPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)

  salePayment Payment? @relation("CustomerOrderPaymentConvertedToSalePayment")

  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, paidAt])
  @@index([cashAccountId])
  @@index([coveredBaseUsd])
}

/// “Pedidos mayoristas” (leads/órdenes) previo a convertir en venta.
model WholesaleOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  customerName String
  // Para simplificar, guardamos el pedido como texto estructurado mínimo
  modelName    String
  color        String?
  capacityGB   Int?
  condition    Condition?
  units        Int        @default(1)

  requestedAt DateTime    @default(now())
  status      OrderStatus @default(OPEN)

  // Precios referenciales del pedido
  unitCostRef  Decimal? @db.Decimal(12, 2)
  unitPriceRef Decimal? @db.Decimal(12, 2)

  notes String?

  @@index([tenantId, status])
}

/// Plantillas de “Costo x Equipo” (accesorios/regalos/comisiones por modelo).
model CostProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name            String // p.ej. "15 de 128 GB"
  funda           Decimal? @db.Decimal(12, 2)
  templado        Decimal? @db.Decimal(12, 2)
  cable           Decimal? @db.Decimal(12, 2)
  tarjetaGarantia Decimal? @db.Decimal(12, 2)
  sticker         Decimal? @db.Decimal(12, 2)
  envio           Decimal? @db.Decimal(12, 2)
  cajita          Decimal? @db.Decimal(12, 2)
  bolsita         Decimal? @db.Decimal(12, 2)
  comision        Decimal? @db.Decimal(12, 2)
  total           Decimal? @db.Decimal(12, 2) // redundante, para consulta rápida

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  SaleItem  SaleItem[]

  @@index([tenantId, name])
}

/// Proveedor desde quien se compran productos. Cada compra está asociada a un proveedor.
model Supplier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name          String
  contactName   String?
  phone         String?
  email         String?
  provinceId    String?
  provinceRef   Province? @relation(fields: [provinceId], references: [id])
  city          String?
  postalCode    String?
  addressStreet String?
  addressNumber String?
  branchId      String?
  branch        Branch?   @relation("SupplierPrimaryBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branchCoverages SupplierBranchCoverage[]
  purchases       Purchase[]
  products        Product[]

  @@index([tenantId, name])
  @@index([provinceId])
  @@index([branchId])
}

/// Representa una compra realizada a un proveedor. Puede contener múltiples ítems.
model Purchase {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  date          DateTime              @default(now())
  downPayment   Decimal?              @db.Decimal(12, 2) // seña o adelanto
  currency      Currency              @default(USD)
  totalCost     Decimal               @db.Decimal(12, 2)
  paymentStatus PurchasePaymentStatus @default(CURRENT_ACCOUNT)
  branchId      String?
  branch        Branch?               @relation(fields: [branchId], references: [id])
  notes         String?
  createdAt     DateTime              @default(now())
  items         PurchaseItem[]
  payments      PurchasePayment[]

  @@index([tenantId, supplierId, date])
  @@index([branchId])
}

/// Ítem de una compra: cuántas unidades de un producto se compraron y a qué costo.
model PurchaseItem {
  id                 String              @id @default(cuid())
  purchaseId         String
  productId          String
  purchase           Purchase            @relation(fields: [purchaseId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  units              Int
  unitCost           Decimal             @db.Decimal(12, 2)
  totalCost          Decimal             @db.Decimal(12, 2)
  customerOrderItems CustomerOrderItem[]

  @@index([purchaseId])
  @@index([productId])
}

/// Cita presencial / turno con un Buyer para ver productos.
model Appointment {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// Buyer asociado a la cita (opcional, se puede cargar sólo nombre suelto si querés en el futuro)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  /// Venta que se concretó a partir de esta cita (opcional)
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  /// Fecha y hora agendada (inicio de la cita)
  scheduledAt DateTime

  /// Duración estimada en minutos (opcional, por si querés dibujar el bloque en un calendario)
  durationMinutes Int?

  /// Estado operativo de la cita (agendada, completada, cancelada, etc.)
  status AppointmentStatus @default(PROGRAMADA)

  /// Resultado comercial de la cita (si hubo venta/no venta)
  outcome AppointmentOutcome @default(PENDIENTE)

  /// Motivo de no venta cuando outcome = NO_SALE
  noSaleReason      AppointmentNoSaleReason?
  noSaleReasonOther String? // texto libre cuando se elige OTHER
  resultNotes       String? // notas internas sobre cómo fue la cita

  /// Productos de interés del Buyer para esta cita
  interests      AppointmentInterest[]
  customerOrders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledAt])
  @@index([buyerId, scheduledAt])
  @@index([status])
}

/// Productos que el Buyer quiere ver en una cita concreta.
model AppointmentInterest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Opcional: prioridad (1 = principal, 2 = secundario, etc.)
  priority Int?
  notes    String?

  @@unique([appointmentId, productId])
  @@index([productId])
}

model Branch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code String
  name String

  /// LEGACY: texto libre historico. Usar provinceId/provinceRef para datos normalizados.
  province    String?
  provinceId  String?
  provinceRef Province? @relation("BranchProvince", fields: [provinceId], references: [id])
  city        String?
  address     String?
  phone       String?
  email       String?

  isActive Boolean @default(true)

  products          Product[]
  sales             Sale[]
  purchases         Purchase[]
  registeredBuyers  Buyer[]                  @relation("BuyerRegisteredBranch")
  provinceCoverages BranchProvinceCoverage[]
  currentUsers      User[]                   @relation("UserCurrentBranch")
  userCoverages     UserBranchCoverage[]
  suppliers         Supplier[]               @relation("SupplierPrimaryBranch")
  supplierCoverages SupplierBranchCoverage[]
  cashAccounts      CashAccount[]
  cashMovements     CashMovement[]
  cashTransfers     CashTransfer[]
  cashDailyCloses   CashDailyClose[]
  reservations      Reservation[]
  customerOrders    CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([provinceId])
}

model BranchProvinceCoverage {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([branchId, provinceId])
  @@index([provinceId])
}

model UserBranchCoverage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

model SupplierBranchCoverage {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([supplierId, branchId])
  @@index([branchId])
}

model PurchasePayment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  currency Currency
  amount   Decimal       @db.Decimal(12, 2)

  exchangeRate  Decimal?     @db.Decimal(12, 4)
  amountUsd     Decimal?     @db.Decimal(12, 2)
  cashAccountId String?
  cashAccount   CashAccount? @relation("PurchasePaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)

  paidAt DateTime @default(now())
  note   String?

  createdAt DateTime @default(now())

  @@index([purchaseId, paidAt])
  @@index([cashAccountId])
}

model Reservation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  convertedSaleId String?
  convertedSale   Sale?   @relation(fields: [convertedSaleId], references: [id])

  reservedAt DateTime  @default(now())
  pickupAt   DateTime?

  agreedTotal Decimal? @db.Decimal(12, 2)
  amountPaid  Decimal? @db.Decimal(12, 2)
  balanceDue  Decimal? @db.Decimal(12, 2)

  status ReservationStatus @default(ACTIVE)

  notes String?

  items    ReservationItem[]
  payments ReservationPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, reservedAt])
  @@index([tenantId, status])
  @@index([buyerId])
  @@index([branchId])
  @@index([convertedSaleId])
}

model ReservationItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  itemName   String
  imeiSerial String?
  quantity   Int      @default(1)
  unitPrice  Decimal? @db.Decimal(12, 2)
  gifts      Json?

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([productId])
}

model ReservationPayment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  currency Currency
  amount   Decimal       @db.Decimal(12, 2)

  exchangeRate         Decimal?     @db.Decimal(12, 4)
  amountUsd            Decimal?     @db.Decimal(12, 2)
  cashAccountId        String?
  cashAccount          CashAccount? @relation("ReservationPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  convertedSalePayment Payment?     @relation("ReservationPaymentConvertedToSalePayment")

  paidAt DateTime @default(now())
  note   String?

  createdAt DateTime @default(now())

  @@index([reservationId, paidAt])
  @@index([cashAccountId])
}

model ServiceOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type ServiceOrderType

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  modelName          String
  imeiSerial         String?
  failureDescription String

  technicianId String?
  technician   User?   @relation("ServiceOrderTechnician", fields: [technicianId], references: [id])

  createdById String?
  createdBy   User?   @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id])

  costAmount  Decimal? @db.Decimal(12, 2)
  priceAmount Decimal? @db.Decimal(12, 2)
  currency    Currency @default(USD)

  status ServiceOrderStatus @default(RECEIVED)

  receivedAt  DateTime  @default(now())
  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, receivedAt])
  @@index([tenantId, status])
  @@index([productId])
  @@index([buyerId])
  @@index([technicianId])
}

model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  actorUserId String?
  actorUser   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id])

  actorRole UserRole?

  executedByAdminInSimulation Boolean   @default(false)
  simulatedRole               UserRole?

  action AuditAction
  module AuditModule

  entityType String
  entityId   String?

  detail String

  oldValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model CashAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code      String
  name      String
  type      CashAccountType
  currency  Currency
  scope     CashAccountScope @default(TENANT)
  branchId  String?
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)

  movements             CashMovement[]
  transfersFrom         CashTransfer[]                  @relation("CashTransferFrom")
  transfersTo           CashTransfer[]                  @relation("CashTransferTo")
  closeSnapshots        CashDailyCloseAccountSnapshot[]
  salePayments          Payment[]                       @relation("SalePaymentCashAccount")
  purchasePayments      PurchasePayment[]               @relation("PurchasePaymentCashAccount")
  reservationPayments   ReservationPayment[]            @relation("ReservationPaymentCashAccount")
  customerOrderPayments CustomerOrderPayment[]          @relation("CustomerOrderPaymentCashAccount")
  closerCommissions     CloserCommission[]              @relation("CloserCommissionCashAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([branchId])
  @@index([tenantId, branchId, isActive])
}

model CashMovement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  direction CashMovementDirection
  category  CashMovementCategory
  detail    String
  amount    Decimal               @db.Decimal(12, 2)
  currency  Currency

  exchangeRate Decimal? @db.Decimal(12, 4)
  amountUsd    Decimal? @db.Decimal(12, 2)

  sourceType CashMovementSource
  sourceId   String?

  transferId String?
  transfer   CashTransfer? @relation(fields: [transferId], references: [id])

  reversalOfId String?       @unique
  reversalOf   CashMovement? @relation("CashMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   CashMovement? @relation("CashMovementReversal")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, category, occurredAt])
  @@index([accountId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([transferId])
}

model CashTransfer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fromAccountId String
  fromAccount   CashAccount @relation("CashTransferFrom", fields: [fromAccountId], references: [id])

  toAccountId String
  toAccount   CashAccount @relation("CashTransferTo", fields: [toAccountId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  kind                  CashTransferKind @default(TRANSFER)
  fromAmount            Decimal          @db.Decimal(12, 2)
  toAmount              Decimal          @db.Decimal(12, 2)
  exchangeRate          Decimal?         @db.Decimal(12, 4)
  benchmarkExchangeRate Decimal?         @db.Decimal(12, 4)
  theoreticalAmountUsd  Decimal?         @db.Decimal(12, 2)
  realAmountUsd         Decimal?         @db.Decimal(12, 2)
  fxResultUsd           Decimal?         @db.Decimal(12, 2)
  detail                String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  movements CashMovement[]

  @@index([tenantId, occurredAt])
  @@index([fromAccountId, occurredAt])
  @@index([toAccountId, occurredAt])
  @@index([branchId, occurredAt])
}

model CashDailyClose {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  closedById String?
  closedBy   User?   @relation("CashDailyCloseClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  businessDate DateTime @db.Date

  incomeUsd  Decimal @default(0) @db.Decimal(12, 2)
  expenseUsd Decimal @default(0) @db.Decimal(12, 2)
  netUsd     Decimal @default(0) @db.Decimal(12, 2)

  closedAt DateTime @default(now())
  notes    String?

  accountSnapshots CashDailyCloseAccountSnapshot[]

  createdAt DateTime @default(now())

  @@unique([tenantId, branchId, businessDate])
  @@index([tenantId, businessDate])
  @@index([branchId, businessDate])
}

model CashDailyCloseAccountSnapshot {
  id String @id @default(cuid())

  closeId String
  close   CashDailyClose @relation(fields: [closeId], references: [id], onDelete: Cascade)

  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  currency   Currency
  balance    Decimal  @db.Decimal(12, 2)
  balanceUsd Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([closeId, accountId])
  @@index([accountId])
}

model CloserCommissionPlan {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String
  base     CloserCommissionBase
  ratePct  Decimal              @db.Decimal(5, 2)
  isActive Boolean              @default(true)

  commissions CloserCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive])
}

model CloserCommission {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  closerId String
  closer   User   @relation("CloserCommissionCloser", fields: [closerId], references: [id])

  planId String?
  plan   CloserCommissionPlan? @relation(fields: [planId], references: [id])

  baseAmount Decimal  @db.Decimal(12, 2)
  ratePct    Decimal  @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(12, 2)
  currency   Currency @default(USD)

  status        CommissionStatus @default(PENDING)
  earnedAt      DateTime         @default(now())
  paidAt        DateTime?
  cashAccountId String?
  cashAccount   CashAccount?     @relation("CloserCommissionCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, earnedAt])
  @@index([saleId])
  @@index([closerId, earnedAt])
  @@index([status])
  @@index([cashAccountId])
}

// ====================== Enums =========================

enum ProductType {
  PHONE
  ACCESSORY
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
  DISCONTINUED
}

enum ProductState {
  EN_STOCK
  EN_CAMINO
  EN_REPARACION
  CON_CLIENTE
  DISPONIBLE
  FUERA_DE_STOCK
  VENDIDO
  EN_REVISION
}

enum SaleStatus {
  CONFIRMADA
  SENADA
  CANCELADA
}

enum SaleItemKind {
  NORMAL // renglón común: suma a subtotal
  ZERO_COST // regalo: baja stock, lineTotal=0
  IN_TOTAL // costo x producto: baja stock y suma su costo a Sale.extraCosts
}

enum Condition {
  A_PLUS
  OEM
  ASIS
  ASIS_PLUS
  SEALED
}

enum OrderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum CustomerOrderStatus {
  CONFIRMED
  PROCUREMENT_PENDING
  ORDERED_TO_SUPPLIER
  IN_TRANSIT
  RECEIVED
  READY_FOR_DELIVERY
  CONVERTED
  CANCELLED
}

enum CustomerOrderSource {
  INTERNAL
  INSTAGRAM
  OFFICE
  ECOMMERCE
  WHATSAPP
  OTHER
}

enum CustomerOrderItemKind {
  STOCK
  ON_DEMAND
}

enum CustomerOrderAllocationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum PaymentMethod {
  EFECTIVO_PESOS
  EFECTIVO_USD
  TRANSFERENCIA_ARS
  TRANSFERENCIA_USD
  TARJETA
  USDT
  PLAN_CANJE
  BNA_CUOTAS
}

/// Moneda utilizada en compras/pagos.
enum Currency {
  ARS
  USD
  USDT
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  CURRENT_ACCOUNT
}

/// Estado operativo de la cita.
enum AppointmentStatus {
  PROGRAMADA // Agendada, futura
  CONCRETADA // Se concretó (haya o no venta)
  CANCELADA // Cancelada antes de que ocurra
  NO_SE_PRESENTO // El cliente no se presentó
}

/// Resultado comercial de la cita.
enum AppointmentOutcome {
  PENDIENTE // Aún no se sabe (cita futura / sin registrar)
  VENTA_CONCRETADA // Se concretó una venta (podés linkear Sale)
  NO_SE_CONCRETO // No se concretó venta
  SENADO // Señaron al menos un producto de la venta
  SENADO_EN_CAMINO // Señaron al menos un producto de la venta y tiene estado EN_CAMINO
  SENADO_EN_STOCK // Señaron al menos un producto de la venta y tiene estado EN_STOCK
}

/// Motivo principal de que no haya venta (cuando outcome = NO_SALE).
enum AppointmentNoSaleReason {
  MUY_CARO // Precio muy alto
  MODELO_NO_DISPONIBLE // No se consiguió el modelo deseado
  ENCONTRO_MEJOR_OFERTA // Encontró mejor oferta
  LO_ESTA_PENSANDO // Lo está pensando / "me lo llevo a pensar"
  NO_SE_PRESENTO // Directamente no vino / no se pudo hacer la demo
  OTRO // Otro motivo (se detalla en noSaleReasonOther)
}

enum UserRole {
  ADMIN
  VENDEDOR
  STOCK
  SOCIO
}

enum SaleType {
  MINORISTA
  MAYORISTA
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  CANCELLED
  EXPIRED
}

enum ServiceOrderType {
  STOCK
  CUSTOMER
}

enum ServiceOrderStatus {
  RECEIVED
  IN_WORKSHOP
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
