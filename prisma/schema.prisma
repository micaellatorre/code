// prisma/schema.prisma
// Venta con Buyer y Payments; accesorios pueden ser:
// - NORMAL (cobra precio)
// - IN_TOTAL (costo x producto: baja stock y suma a Sale.extraCosts)
// Además, SaleItem puede vincularse a un teléfono via parentItemId.
// Se mantiene CostProfile para extras por teléfono; SaleItem guarda selección/desglose en JSON.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  image       String?
  isActive    Boolean   @default(true)
  role        UserRole
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  lastLoginAt DateTime?

  appointments Appointment[]
  sales        Sale[]
}

/// Pensado para SaaS a futuro. En R1 podés crear 1 Tenant por defecto y listo.
// El Tenant administra sus productos, ventas, órdenes, compras y proveedores. Como un encargado por sucursal.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  sales        Sale[]
  orders       WholesaleOrder[]
  costProfiles CostProfile[]
  purchases    Purchase[]
  suppliers    Supplier[]
  buyers       Buyer[]
  users        User[]
}

/// Catálogo unificado: iPhones y accesorios.
// Para MVP trabajamos con stock agregado (no por IMEI). IMEI se puede agregar en el futuro.
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type           ProductType // PHONE | ACCESSORY
  brand          String? // p.ej. "Apple" (opcional en accesorios)
  imei           String? // opcional, sólo si se maneja por IMEI
  modelName      String // p.ej. "iPhone 15 Pro", "Funda 14 Pro Max"
  capacityGB     Int? // sólo aplica a PHONE
  condition      Condition? // A_PLUS | OEM | ASIS | ASIS_PLUS | SEALED (para PHONE)
  color          String?
  batteryPct     Int? // sólo PHONE; si aplica
  purchaseDate   DateTime? // fecha_de_compra
  costPrice      Decimal       @db.Decimal(12, 2) // costo_x_unidad
  salePrice      Decimal       @db.Decimal(12, 2) // precio_venta_x_unidad (precio sugerido/base)
  shippingCost   Decimal?      @db.Decimal(12, 2) // costo_envio (si es fijo/por unidad)
  status         ProductStatus @default(AVAILABLE)
  state          ProductState  @default(EN_CAMINO) // estado actual del producto
  senado         Boolean       @default(false)
  senadoAt       DateTime?
  stockInitial   Int           @default(1) // stock inicial
  stock          Int           @default(1) // stock actual
  stockAvailable Int           @default(1) // stock disponible para venta
  location       String? // opcional, para saber dónde está el producto, después se puede usar para filtrar por ubicación y agregar un modelo Sede con datos de ubiacion, contacto, direccion, etc.
  origin         String? // "Proveedor Alex", "Compra en ML", "Trade-in Apple", "Plan Canje", etc.
  notes          String?

  saleItems    SaleItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  PurchaseItem PurchaseItem[]

  // NUEVO: productos marcados como “de interés” en citas
  appointmentInterests AppointmentInterest[]

  @@index([tenantId, type, modelName])
  @@index([tenantId, modelName, capacityGB, condition])
}

/// Entidad Comprador (cliente final) para analytics y campañas.
model Buyer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  // Datos mínimos; ampliar cuando sea necesario
  name      String
  surname   String?
  dob       DateTime? // fecha de nacimiento
  phone     String?
  instagram String?
  email     String?
  cuit      String?
  dni       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  // NUEVO
  appointments Appointment[]

  @@index([tenantId, name])
  @@index([tenantId, instagram])
  @@index([tenantId, phone])
}

/// Venta encabezado.
model Sale {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  date         DateTime @default(now())
  customerName String? // libre si no hay Buyer (legacy)
  origin       String? // "Local", "Conocido", "Instagram", etc.
  notes        String?

  // Relación con Buyer (opcional)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  items    SaleItem[]
  payments Payment[]

  // NUEVO: citas que terminaron en esta venta (en la práctica suele ser 0 o 1)
  appointments Appointment[]

  status     SaleStatus @default(CONFIRMADA)
  amountPaid Decimal    @default(0) @db.Decimal(12, 2)
  balanceDue Decimal    @default(0) @db.Decimal(12, 2)

  // Totales (recomendado recalcular en servidor)
  subtotal   Decimal  @db.Decimal(12, 2) // Σ (NORMAL line: units*unitPrice)
  costTotal  Decimal  @default(0) @db.Decimal(12, 2) // Σ (items.unitCost)
  extraCosts Decimal  @db.Decimal(12, 2) // Σ (IN_TOTAL items + extraCost de CostProfile en PHONE)
  total      Decimal  @db.Decimal(12, 2) // subtotal + extraCosts
  profit     Decimal  @db.Decimal(12, 2) // total - costo_total
  createdAt  DateTime @default(now())

  @@index([tenantId, date])
  @@index([buyerId])
  @@index([status])
}

/// Renglón de una venta.
// Puede vincularse a otro renglón (p. ej., accesorio vinculado al teléfono) vía parentItemId.
model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Vinculación jerárquica: accesorios colgados de un PHONE
  parentItemId String?
  parentItem   SaleItem?  @relation("SaleItemChildren", fields: [parentItemId], references: [id], onDelete: SetNull)
  children     SaleItem[] @relation("SaleItemChildren")

  // Modo del renglón (ver lógica de totales)
  kind SaleItemKind @default(NORMAL)

  units     Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2) // precio_venta por unidad (0 si ZERO_COST)
  unitCost  Decimal @db.Decimal(12, 2) // costo base del producto (sin extras)

  // CostProfile aplicado (sólo si corresponde, típicamente en PHONE)
  costProfileAppliedId String?
  costProfileApplied   CostProfile? @relation(fields: [costProfileAppliedId], references: [id])

  // Extras seleccionados del CostProfile para este ítem (PHONE)
  // Ej.: ["FUNDA","ENVIO"]; desglose: { FUNDA: "100.00", ENVIO: "500.00" }
  selectedExtras     Json?
  extraCostBreakdown Json?

  // Cache para cálculos por ítem:
  // - extraCost: por unidad desde CostProfile (solo PHONE)
  // - lineTotal: si kind=NORMAL -> units*unitPrice; si ZERO_COST -> 0; si IN_TOTAL -> 0 (se suma en Sale.extraCosts)
  // - lineCost: units * unitCost + (units * extraCost)  (el accesorio IN_TOTAL no entra aquí como precio)
  // - lineProfit: lineTotal - lineCost
  extraCost  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  lineCost   Decimal @db.Decimal(12, 2)
  lineProfit Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([parentItemId])
  @@index([kind])
}

/// Pago asociado a una venta (sustituye Sale.payment simple).
model Payment {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method   PaymentMethod
  currency Currency      @default(USD) // es mas complejo porque puede estar en diferentes currencies, pero lo ideal seria llevar los payments con currency != USD a su valor equivalente en USD
  amount   Decimal       @db.Decimal(12, 2)
  paidAt   DateTime      @default(now())
  note     String?

  createdAt DateTime @default(now())

  @@index([saleId, paidAt])
}

/// “Pedidos mayoristas” (leads/órdenes) previo a convertir en venta.
model WholesaleOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  customerName String
  // Para simplificar, guardamos el pedido como texto estructurado mínimo
  modelName    String
  color        String?
  capacityGB   Int?
  condition    Condition?
  units        Int        @default(1)

  requestedAt DateTime    @default(now())
  status      OrderStatus @default(OPEN)

  // Precios referenciales del pedido
  unitCostRef  Decimal? @db.Decimal(12, 2)
  unitPriceRef Decimal? @db.Decimal(12, 2)

  notes String?

  @@index([tenantId, status])
}

/// Plantillas de “Costo x Equipo” (accesorios/regalos/comisiones por modelo).
model CostProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name            String // p.ej. "15 de 128 GB"
  funda           Decimal? @db.Decimal(12, 2)
  templado        Decimal? @db.Decimal(12, 2)
  cable           Decimal? @db.Decimal(12, 2)
  tarjetaGarantia Decimal? @db.Decimal(12, 2)
  sticker         Decimal? @db.Decimal(12, 2)
  envio           Decimal? @db.Decimal(12, 2)
  cajita          Decimal? @db.Decimal(12, 2)
  bolsita         Decimal? @db.Decimal(12, 2)
  comision        Decimal? @db.Decimal(12, 2)
  total           Decimal? @db.Decimal(12, 2) // redundante, para consulta rápida

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  SaleItem  SaleItem[]

  @@index([tenantId, name])
}

/// Proveedor desde quien se compran productos. Cada compra está asociada a un proveedor.
model Supplier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  contactName String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@index([tenantId, name])
}

/// Representa una compra realizada a un proveedor. Puede contener múltiples ítems.
model Purchase {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  date        DateTime       @default(now())
  downPayment Decimal?       @db.Decimal(12, 2) // seña o adelanto
  currency    Currency       @default(USD)
  totalCost   Decimal        @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime       @default(now())
  items       PurchaseItem[]

  @@index([tenantId, supplierId, date])
}

/// Ítem de una compra: cuántas unidades de un producto se compraron y a qué costo.
model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  units      Int
  unitCost   Decimal  @db.Decimal(12, 2)
  totalCost  Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

/// Cita presencial / turno con un Buyer para ver productos.
model Appointment {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// Buyer asociado a la cita (opcional, se puede cargar sólo nombre suelto si querés en el futuro)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])

  /// Venta que se concretó a partir de esta cita (opcional)
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  /// Fecha y hora agendada (inicio de la cita)
  scheduledAt DateTime

  /// Duración estimada en minutos (opcional, por si querés dibujar el bloque en un calendario)
  durationMinutes Int?

  /// Estado operativo de la cita (agendada, completada, cancelada, etc.)
  status AppointmentStatus @default(PROGRAMADA)

  /// Resultado comercial de la cita (si hubo venta/no venta)
  outcome AppointmentOutcome @default(PENDIENTE)

  /// Motivo de no venta cuando outcome = NO_SALE
  noSaleReason      AppointmentNoSaleReason?
  noSaleReasonOther String? // texto libre cuando se elige OTHER
  resultNotes       String? // notas internas sobre cómo fue la cita

  /// Productos de interés del Buyer para esta cita
  interests AppointmentInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledAt])
  @@index([buyerId, scheduledAt])
  @@index([status])
}

/// Productos que el Buyer quiere ver en una cita concreta.
model AppointmentInterest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Opcional: prioridad (1 = principal, 2 = secundario, etc.)
  priority Int?
  notes    String?

  @@unique([appointmentId, productId])
  @@index([productId])
}

// ====================== Enums =========================

enum ProductType {
  PHONE
  ACCESSORY
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
  DISCONTINUED
}

enum ProductState {
  EN_STOCK
  EN_CAMINO
  EN_REPARACION
  CON_CLIENTE
  DISPONIBLE
  FUERA_DE_STOCK
  RESERVADO
  VENDIDO
}

enum SaleStatus {
  CONFIRMADA
  SENADA
  CANCELADA
}

enum SaleItemKind {
  NORMAL // renglón común: suma a subtotal
  ZERO_COST // regalo: baja stock, lineTotal=0
  IN_TOTAL // costo x producto: baja stock y suma su costo a Sale.extraCosts
}

enum Condition {
  A_PLUS
  OEM
  ASIS
  ASIS_PLUS
  SEALED
}

enum OrderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  EFECTIVO_PESOS
  EFECTIVO_USD
  TRANSFERENCIA_ARS
  TRANSFERENCIA_USD
  TARJETA
  USDT
}

/// Moneda utilizada en compras/pagos.
enum Currency {
  ARS
  USD
  USDT
}

/// Estado operativo de la cita.
enum AppointmentStatus {
  PROGRAMADA // Agendada, futura
  CONCRETADA // Se concretó (haya o no venta)
  CANCELADA // Cancelada antes de que ocurra
  NO_SE_PRESENTO // El cliente no se presentó
}

/// Resultado comercial de la cita.
enum AppointmentOutcome {
  PENDIENTE // Aún no se sabe (cita futura / sin registrar)
  VENTA_CONCRETADA // Se concretó una venta (podés linkear Sale)
  NO_SE_CONCRETO // No se concretó venta
  SENADO // Señaron al menos un producto de la venta
  SENADO_EN_CAMINO // Señaron al menos un producto de la venta y tiene estado EN_CAMINO
  SENADO_EN_STOCK // Señaron al menos un producto de la venta y tiene estado EN_STOCK
}

/// Motivo principal de que no haya venta (cuando outcome = NO_SALE).
enum AppointmentNoSaleReason {
  MUY_CARO // Precio muy alto
  MODELO_NO_DISPONIBLE // No se consiguió el modelo deseado
  ENCONTRO_MEJOR_OFERTA // Encontró mejor oferta
  LO_ESTA_PENSANDO // Lo está pensando / "me lo llevo a pensar"
  NO_SE_PRESENTO // Directamente no vino / no se pudo hacer la demo
  OTRO // Otro motivo (se detalla en noSaleReasonOther)
}

enum UserRole {
  ADMIN
  VENDEDOR
  STOCK
  SOCIO
}
